{
  "name": "@fieldline/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, migrations, row-level security, database client (PGlite locally, Postgres hosted) and the demo seed.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "reset": "tsx src/scripts/reset.ts",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@fieldline/shared": "*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3"
  }
}
