# Copy to .env at the repo root. Every value has a working local default; nothing is required to run `npm run setup`.

# Database. Leave unset to use the embedded PGlite Postgres in ./data/pglite (no install needed).
# For hosted Postgres (Supabase, Neon, RDS) set a connection string and the API switches to the `pg` driver.
# DATABASE_URL=postgres://user:pass@host:5432/fieldline

# API
API_PORT=8787
# Secret used to sign session cookies. Change it outside local development.
SESSION_SECRET=dev-only-change-me
# Where uploaded photos, signatures and PDFs are stored by the local file adapter.
FILES_DIR=./data/files
# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173

# Web
VITE_API_URL=http://localhost:8787

# Integrations (all optional; the app runs with none of them and shows "not connected" in Settings)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# STRIPE_SECRET_KEY=
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# GOOGLE_MAPS_API_KEY=
# CLERK_SECRET_KEY=
