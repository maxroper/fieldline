{
  "name": "@fieldline/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Fieldline API: Hono on Node, Drizzle over Postgres with row-level security, session auth, server-sent events for the live board, local file storage.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fieldline/db": "*",
    "@fieldline/shared": "*",
    "@hono/node-server": "^1.19.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.10.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "exports": {
    ".": "./src/app.ts",
    "./demo": "./src/demo.ts",
    "./realtime": "./src/realtime.ts"
  }
}
