{
  "name": "@fieldline/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Fieldline web app: office desktop screens, the tech phone screens, and the customer pages. Vite, React 19, TanStack Router and Query.",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build:demo": "VITE_DEMO=1 vite build && node scripts/finish-demo.mjs",
    "preview:demo": "VITE_BASE=/fieldline/ vite preview --port 4173 --strictPort"
  },
  "dependencies": {
    "@fieldline/api": "*",
    "@fieldline/db": "*",
    "@fieldline/shared": "*",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.132.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.132.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
